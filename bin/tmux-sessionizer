#!/usr/bin/env bash
# tmux-sessionizer — テーマ別 tmux セッションの選択 / 作成 / プリセット管理
#
# 使い方:
#   tmux-sessionizer            fzf で選択して切り替え。一覧に無い名前を入力して
#                               Enter すれば、その名前でセッションを新規作成する。
#   tmux-sessionizer switch NAME
#                               指定セッションへ移動（無ければ作成）。tmux の中なら
#                               switch-client、外なら attach-session。
#   tmux-sessionizer add NAME [DIR]
#                               プリセットに追加。DIR を省略し、そのセッションが
#                               起動中なら現在のディレクトリを記録する。
#                               既に登録済みでディレクトリが空の行は、そこへ
#                               埋める（既に入っている値は上書きしない）。
#   tmux-sessionizer del NAME   プリセットから削除（起動中のセッションは消さない）
#   tmux-sessionizer list       プリセットの「名前だけ」を表示（zsh 補完が使う）
#   tmux-sessionizer dir [NAME] テーマのディレクトリを表示（省略時は現在のセッション）
#   tmux-sessionizer edit       プリセットを $EDITOR で開く
#   tmux-sessionizer menu       fzf に渡す一覧を出力（内部利用）
#
# fzf 内のキー:
#   enter   選択（無ければ作成）して切り替え
#   ctrl-a  入力中の名前（空なら選択行）をプリセットへ追加。
#           選択したセッションが起動中なら、その現在地をディレクトリとして
#           一緒に記録する。未起動の名前を打って追加した場合はディレクトリが
#           空のまま入るので、あとでそのセッションを作って作業してから
#           もう一度 ctrl-a を押せば埋まる。
#   ctrl-x  選択行をプリセットから削除
#
# 一覧の記号:
#   ●  起動中のセッション
#   ○  プリセットのみ（未起動）
#
# プリセットの実体は $TMUX_SESSIONS_FILE（既定 ~/.config/tmux/sessions）。
# dotfiles には含めないローカルファイルなので、マシンごとに違うテーマを持てる。
# 初回実行時に既定のテーマで自動生成される。
#
# ── プリセットの書式 ──────────────────────────────────────────────
#   1 行 1 セッション。「名前」または「名前<空白>ディレクトリ」。
#
#     game    ~/games/grimdawn
#     work    ~/kanden-python
#     any
#
#   ディレクトリを書くと、そのテーマのセッションを新規作成するとき
#   `new-session -c <dir>` で開く。テーマとディレクトリを 1:1 に固定するのが
#   狙いで、Claude Code の bg ジョブが cwd で分類される（`claude agents --cwd`
#   で絞れる）ことと噛み合わせるためにある。
#   ディレクトリ無しの行は従来どおり動く（作成時の cwd は tmux 任せ）。
#   名前は最初の空白まで。名前自体に空白を含めたい場合はプリセットに置けない
#   （fzf で直接打ち込めば作成はできる）。
#   先頭の `~` は $HOME に展開する。それ以外の変数展開はしない。

set -uo pipefail

CONF="${TMUX_SESSIONS_FILE:-${XDG_CONFIG_HOME:-$HOME/.config}/tmux/sessions}"
# fzf の --bind から自分自身を再実行するため、絶対パスに解決しておく
# （popup の非対話シェルでは PATH に ~/dotfiles/bin が無いことがある）。
SELF=$(readlink -f -- "$(command -v -- "$0")" 2>/dev/null) || SELF="$0"

TAB=$'\t'

die() {
    printf 'tmux-sessionizer: %s\n' "$*" >&2
    exit 1
}

# 前後の空白を落とし、tmux と同じ規則で '.' ':' を '_' に置換する。
# tmux はセッション名のこの 2 文字を黙って '_' にするため、先に同じ正規化を
# しておかないと、作成後の has-session / switch-client が別名を指して失敗する。
normalize_name() {
    local s="$1"
    s="${s#"${s%%[![:space:]]*}"}"
    s="${s%"${s##*[![:space:]]}"}"
    printf '%s' "${s//[.:]/_}"
}

# 先頭の `~` だけ展開する。eval は使わない（プリセットは手で編集するファイルで、
# 任意のコマンドを実行できてしまうのは割に合わない）。
expand_path() {
    local p="$1"
    case "$p" in
        '~') printf '%s' "$HOME" ;;
        '~/'*) printf '%s/%s' "$HOME" "${p#\~/}" ;;
        *) printf '%s' "$p" ;;
    esac
}

# 表示用に $HOME を ~ へ畳む
shorten_path() {
    local p="$1"
    case "$p" in
        "$HOME") printf '~' ;;
        "$HOME"/*) printf '~/%s' "${p#"$HOME"/}" ;;
        *) printf '%s' "$p" ;;
    esac
}

init_conf() {
    [ -f "$CONF" ] && return 0
    mkdir -p -- "$(dirname -- "$CONF")" || return 1
    cat > "$CONF" <<'EOF'
# tmux-sessionizer のプリセット。
# 1 行 1 セッション。「名前」または「名前<空白>ディレクトリ」。
# '#' で始まる行と空行は無視される。先頭の ~ は $HOME に展開される。
#
#   game    ~/games/grimdawn
#   any
game
work
htb
novel
EOF
}

# プリセットを「名前 TAB ディレクトリ(生)」で出力する。
# ディレクトリ未指定の行は 2 列目が空になる。
presets_raw() {
    init_conf || return 1
    awk -v OFS='\t' '
        { sub(/^[[:space:]]+/, ""); sub(/[[:space:]]+$/, "") }
        !NF || /^#/ { next }
        {
            # 最初の空白までが名前、残りがディレクトリ
            i = match($0, /[[:space:]]/)
            if (i == 0) { print $0, "" }
            else {
                name = substr($0, 1, i - 1)
                dir  = substr($0, i + 1)
                sub(/^[[:space:]]+/, "", dir)
                print name, dir
            }
        }
    ' "$CONF"
}

# 名前だけ（zsh 補完が `list` の出力をそのまま使うので、ここは変えない）
presets() {
    presets_raw | cut -f1
}

# 起動中セッションの現在地（アクティブペインの cwd）。
# display-message -t '=name' はセッション名をペイン target に解決できず空を返す
# （実測）ので、list-panes -s から拾う。
session_cwd() {
    local name="$1"
    tmux list-panes -s -t "=$name" -F '#{?pane_active,#{pane_current_path},}' 2> /dev/null \
        | awk 'NF { print; exit }'
}

# 指定テーマのディレクトリを展開して返す（未設定なら空）
preset_dir() {
    local name="$1" raw
    raw=$(presets_raw | awk -F'\t' -v n="$name" '$1 == n { print $2; exit }')
    [ -z "$raw" ] && return 0
    expand_path "$raw"
}

cmd_add() {
    # 最初の空でない引数を名前として採用する
    # （fzf からは `add {q} {2}` で「入力中の文字列 → 選択行」の順に渡される）
    local name="" dir="" a
    for a in "$@"; do
        # '/' や '~' で始まる引数はディレクトリ指定とみなす。fzf から渡ってくる
        # 名前候補と取り違えないための判定。
        case "$a" in
            /* | '~'/* | '~') [ -z "$dir" ] && dir="$a"; continue ;;
        esac
        if [ -n "$a" ] && [ -z "$name" ]; then
            name="$a"
        fi
    done
    name=$(normalize_name "$name")
    [ -z "$name" ] && return 0
    init_conf || return 1

    # DIR 省略時、そのセッションが起動中なら現在地を拾って記録する
    if [ -z "$dir" ] && tmux has-session -t "=$name" 2> /dev/null; then
        local cur
        cur=$(session_cwd "$name")
        [ -n "$cur" ] && dir=$(shorten_path "$cur")
    fi

    # 既に登録済みの場合は、ディレクトリが空のときだけ埋める。
    # 「名前だけで登録 → セッションを作って作業 → もう一度 ctrl-a」で後から
    # ディレクトリを記録できるようにするため。既に入っている値は触らない
    # （ペインが一時的にサブディレクトリに居るだけで上書きされると困る。
    #   変更したいときは `edit` でファイルを直す）。
    if presets | awk -v n="$name" '$0 == n { found = 1 } END { exit !found }'; then
        [ -z "$dir" ] && return 0
        local existing
        existing=$(presets_raw | awk -F'\t' -v n="$name" '$1 == n { print $2; exit }')
        [ -n "$existing" ] && return 0
        local tmp
        tmp=$(mktemp -- "${CONF}.XXXXXX") || return 1
        if awk -v n="$name" -v d="$dir" '
            {
                line = $0
                sub(/^[[:space:]]+/, "", line); sub(/[[:space:]]+$/, "", line)
                if (line == "" || line ~ /^#/) { print; next }
                i = match(line, /[[:space:]]/)
                nm = (i == 0) ? line : substr(line, 1, i - 1)
                if (nm == n && i == 0) { printf "%s\t%s\n", n, d; next }
                print
            }
        ' "$CONF" > "$tmp"; then
            mv -f -- "$tmp" "$CONF"
        else
            rm -f -- "$tmp"
            return 1
        fi
        return 0
    fi

    if [ -n "$dir" ]; then
        printf '%s\t%s\n' "$name" "$dir" >> "$CONF"
    else
        printf '%s\n' "$name" >> "$CONF"
    fi
}

cmd_del() {
    local name="${1:-}"
    [ -z "$name" ] && return 0
    init_conf || return 1
    local tmp
    tmp=$(mktemp -- "${CONF}.XXXXXX") || return 1
    # 名前の列だけを見て消す（ディレクトリ付きの行にも効くように）
    if awk -v n="$name" '
        {
            line = $0
            sub(/^[[:space:]]+/, "", line); sub(/[[:space:]]+$/, "", line)
            if (line == "" || line ~ /^#/) { print; next }
            i = match(line, /[[:space:]]/)
            nm = (i == 0) ? line : substr(line, 1, i - 1)
            if (nm == n) next
            print
        }
    ' "$CONF" > "$tmp"; then
        mv -f -- "$tmp" "$CONF"
    else
        rm -f -- "$tmp"
        return 1
    fi
}

cmd_edit() {
    init_conf || return 1
    exec "${EDITOR:-vi}" "$CONF"
}

# テーマのディレクトリを表示する。引数を省くと今いるセッションを見る。
# `claude agents --cwd "$(tmux-sessionizer dir)"` のように使う想定。
cmd_dir() {
    local name="${1:-}"
    if [ -z "$name" ] && [ -n "${TMUX:-}" ]; then
        name=$(tmux display-message -p '#S' 2> /dev/null) || name=""
    fi
    [ -z "$name" ] && return 0
    local d
    d=$(preset_dir "$name")
    # プリセットに無ければ、起動中セッションの現在地で代替する
    if [ -z "$d" ] && tmux has-session -t "=$name" 2> /dev/null; then
        d=$(session_cwd "$name")
    fi
    [ -n "$d" ] && printf '%s\n' "$d"
}

# 起動中セッション（●）→ 未起動のプリセット（○）の順に並べ、現在のセッションは除く
# 出力は「記号 TAB 名前 TAB ディレクトリ(表示用)」。
cmd_menu() {
    # tmux の外から実行した場合は除外対象なし。$TMUX 未設定でも display-message は
    # 「最後に使われたクライアント」のセッションを返してしまい、attach したい
    # セッションが一覧から消えるため、tmux 内にいるときだけ現在名を取る。
    local current=""
    if [ -n "${TMUX:-}" ]; then
        current=$(tmux display-message -p '#S' 2>/dev/null) || current=""
    fi
    # 「タグ TAB 名前」で組み立て、表示用の記号は最後に付ける。ロケール対策:
    #   - mawk は C ロケール（LANG の無い zsh -lc 等）だと多バイト文字を '_' に
    #     潰すので、●/○ を awk に通さない。awk が見るのは ASCII のタグ (R/P)。
    #   - tmux の -F にタブは渡せない。UTF-8 では通るが C ロケールでは '_' に
    #     置換されるため、tmux には名前だけ出させてタグ付けは awk 側で行う。
    # 区切りをタブにしておくと、名前に空白があっても後段の抽出がずれない。
    {
        tmux list-sessions -F '#S' 2>/dev/null | awk '{ print "R\t" $0 }'
        presets | awk '{ print "P\t" $0 }'
    } | awk -F'\t' -v cur="$current" '
        $2 == cur { next }
        !seen[$2]++ { print }
    ' | while IFS=$'\t' read -r kind name; do
        local d
        d=$(preset_dir "$name")
        [ -n "$d" ] && d=$(shorten_path "$d")
        case "$kind" in
            R) printf '●\t%s\t%s\n' "$name" "$d" ;;
            *) printf '○\t%s\t%s\n' "$name" "$d" ;;
        esac
    done
}

# 指定名のセッションへ移動する（無ければ作成）。
# tmux の中なら switch-client、外なら attach-session。
goto_session() {
    local name
    name=$(normalize_name "${1:-}")
    [ -z "$name" ] && return 0
    if ! tmux has-session -t "=$name" 2>/dev/null; then
        # プリセットにディレクトリがあればそこで開く。無い / 存在しない場合は
        # tmux 任せ（従来どおり）にして、作成自体は失敗させない。
        local dir
        dir=$(preset_dir "$name")
        if [ -n "$dir" ] && [ -d "$dir" ]; then
            tmux new-session -d -s "$name" -c "$dir" || return 1
        else
            [ -n "$dir" ] && printf 'tmux-sessionizer: %s: ディレクトリが無いので既定の場所で作成します\n' "$dir" >&2
            tmux new-session -d -s "$name" || return 1
        fi
    fi
    if [ -n "${TMUX:-}" ]; then
        tmux switch-client -t "=$name"
    else
        tmux attach-session -t "=$name"
    fi
}

cmd_pick() {
    command -v fzf > /dev/null 2>&1 || die "fzf が見つかりません（prefix + S の choose-tree を使ってください）"

    local out rc sel
    out=$(cmd_menu | fzf \
        --reverse \
        --prompt='session> ' \
        --header='enter:切替/作成  ctrl-a:プリセット追加  ctrl-x:プリセット削除' \
        --delimiter=$'\t' --nth=2 --with-nth='1,2,3' --tabstop=2 \
        --bind="ctrl-a:execute-silent('$SELF' add {q} {2})+reload('$SELF' menu)" \
        --bind="ctrl-x:execute-silent('$SELF' del {2})+reload('$SELF' menu)" \
        --print-query)
    rc=$?
    # 0: 選択あり / 1: 一致なし（＝入力した名前で新規作成）
    # 130 (Esc, C-c) などは何もしない。--print-query は中断時も query を出すため
    # 終了コードで分岐しないと、Esc で意図しないセッションを作ってしまう。
    case $rc in
        0 | 1) ;;
        *) return 0 ;;
    esac

    # 最終行は「選択行（記号 TAB 名前 TAB ディレクトリ）」か「入力文字列（タブ無し）」。
    # 列が増えたので $NF（＝ディレクトリ）ではなく、2 列目を名前として取る。
    # タブが無い行（入力文字列）は 1 列目がそのまま名前になる。
    sel=$(printf '%s\n' "$out" | tail -1 | awk -F'\t' '{ print (NF >= 2 ? $2 : $1) }')
    goto_session "$sel"
}

case "${1:-}" in
    switch) shift; goto_session "${1:-}" ;;
    add)  shift; cmd_add "$@" ;;
    del)  shift; cmd_del "${1:-}" ;;
    list) presets ;;
    dir)  shift; cmd_dir "${1:-}" ;;
    edit) cmd_edit ;;
    menu) cmd_menu ;;
    -h | --help | help)
        # 先頭のコメントブロック（shebang を除く）をそのままヘルプとして出す
        awk '
            NR == 1 { next }
            /^#/    { sub(/^#[[:space:]]?/, ""); print; next }
            { exit }
        ' "$SELF"
        ;;
    "")   cmd_pick ;;
    *)    die "unknown subcommand: $1（--help を参照）" ;;
esac
