{
  "enabledPlugins": {
    "claude-code-setup@claude-plugins-official": true,
    "claude-obsidian@claude-obsidian-marketplace": false
  },
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "extraKnownMarketplaces": {
    "claude-obsidian-marketplace": {
      "source": {
        "repo": "AgriciDaniel/claude-obsidian",
        "source": "github"
      }
    }
  },
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "async": true,
            "command": "if [ -x \"$HOME/.claude/hooks/cc-status.sh\" ]; then exec \"$HOME/.claude/hooks/cc-status.sh\" waiting; fi",
            "type": "command"
          }
        ],
        "matcher": "permission_prompt|agent_needs_input"
      },
      {
        "hooks": [
          {
            "async": true,
            "command": "if [ -x \"$HOME/.claude/hooks/cc-status.sh\" ]; then exec \"$HOME/.claude/hooks/cc-status.sh\" done; fi",
            "type": "command"
          }
        ],
        "matcher": "agent_completed"
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "async": false,
            "command": "if [ -x \"$HOME/.local/bin/moshi-hook\" ]; then exec \"$HOME/.local/bin/moshi-hook\" claude-hook; fi",
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "async": true,
            "command": "if [ -x \"$HOME/.claude/hooks/cc-status.sh\" ]; then exec \"$HOME/.claude/hooks/cc-status.sh\" waiting; fi",
            "type": "command"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "async": true,
            "command": "if [ -x \"$HOME/.local/bin/moshi-hook\" ]; then exec \"$HOME/.local/bin/moshi-hook\" claude-hook; fi",
            "type": "command"
          }
        ],
        "matcher": "AskUserQuestion"
      },
      {
        "hooks": [
          {
            "async": true,
            "command": "if [ -x \"$HOME/.local/bin/moshi-hook\" ]; then exec \"$HOME/.local/bin/moshi-hook\" claude-hook; fi",
            "type": "command"
          }
        ],
        "matcher": "ExitPlanMode"
      },
      {
        "hooks": [
          {
            "async": true,
            "command": "if [ -x \"$HOME/.claude/hooks/cc-status.sh\" ]; then exec \"$HOME/.claude/hooks/cc-status.sh\" busy; fi",
            "type": "command"
          }
        ],
        "matcher": "AskUserQuestion|ExitPlanMode"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "async": false,
            "command": "if command -v python3 >/dev/null 2>&1 && [ -f \"$HOME/.claude/hooks/deny-grep.py\" ]; then exec python3 \"$HOME/.claude/hooks/deny-grep.py\"; fi",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      },
      {
        "hooks": [
          {
            "async": true,
            "command": "if [ -x \"$HOME/.local/bin/moshi-hook\" ]; then exec \"$HOME/.local/bin/moshi-hook\" claude-hook; fi",
            "type": "command"
          }
        ],
        "matcher": "AskUserQuestion"
      },
      {
        "hooks": [
          {
            "async": true,
            "command": "if [ -x \"$HOME/.local/bin/moshi-hook\" ]; then exec \"$HOME/.local/bin/moshi-hook\" claude-hook; fi",
            "type": "command"
          }
        ],
        "matcher": "ExitPlanMode"
      },
      {
        "hooks": [
          {
            "async": true,
            "command": "if [ -x \"$HOME/.claude/hooks/cc-status.sh\" ]; then exec \"$HOME/.claude/hooks/cc-status.sh\" waiting; fi",
            "type": "command"
          }
        ],
        "matcher": "AskUserQuestion|ExitPlanMode"
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "async": true,
            "command": "if [ -x \"$HOME/.local/bin/moshi-hook\" ]; then exec \"$HOME/.local/bin/moshi-hook\" claude-hook; fi",
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "async": true,
            "command": "if [ -x \"$HOME/.claude/hooks/cc-status.sh\" ]; then exec \"$HOME/.claude/hooks/cc-status.sh\" clear; fi",
            "type": "command"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "async": true,
            "command": "if [ -x \"$HOME/.local/bin/moshi-hook\" ]; then exec \"$HOME/.local/bin/moshi-hook\" claude-hook; fi",
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "async": true,
            "command": "if [ -x \"$HOME/.local/bin/moshi-hook\" ]; then exec \"$HOME/.local/bin/moshi-hook\" claude-hook; fi",
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "async": true,
            "command": "if [ -x \"$HOME/.claude/hooks/cc-status.sh\" ]; then exec \"$HOME/.claude/hooks/cc-status.sh\" done; fi",
            "type": "command"
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "async": true,
            "command": "if [ -x \"$HOME/.claude/hooks/cc-status.sh\" ]; then exec \"$HOME/.claude/hooks/cc-status.sh\" waiting; fi",
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "async": true,
            "command": "if [ -x \"$HOME/.local/bin/moshi-hook\" ]; then exec \"$HOME/.local/bin/moshi-hook\" claude-hook; fi",
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "async": true,
            "command": "if [ -x \"$HOME/.claude/hooks/cc-status.sh\" ]; then exec \"$HOME/.claude/hooks/cc-status.sh\" busy; fi",
            "type": "command"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(git add:*)",
      "Bash(git branch:*)",
      "Bash(git checkout:*)",
      "Bash(git clone:*)",
      "Bash(git commit:*)",
      "Bash(git fetch:*)",
      "Bash(git grep:*)",
      "Bash(git init:*)",
      "Bash(git merge:*)",
      "Bash(git pull:*)",
      "Bash(git push:*)",
      "Bash(git rebase:*)",
      "Bash(git reset:*)",
      "Bash(git rm:*)",
      "Bash(git stash:*)",
      "Bash(gh api:*)",
      "Bash(gh issue:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh pr view:*)",
      "Bash(gh repo:*)",
      "Bash(gh search:*)",
      "Bash(ag:*)",
      "Bash(chmod +x:*)",
      "Bash(echo:*)",
      "Bash(find:*)",
      "Bash(ls:*)",
      "Bash(pdfinfo:*)",
      "Bash(pdftotext:*)",
      "Bash(printf:*)",
      "Bash(rg:*)",
      "Bash(tree:*)",
      "Bash(wc:*)",
      "Bash(claude:*)",
      "Bash(dpkg -l:*)",
      "Bash(make deploy:*)",
      "Bash(make help:*)",
      "Bash(make test:*)",
      "Bash(nvim:*)",
      "Bash(ss:*)",
      "Bash(systemctl is-active:*)",
      "Bash(tmux:*)",
      "Bash(wezterm cli:*)",
      "Bash(who:*)",
      "Bash(npm:*)",
      "Bash(npx tsc:*)",
      "Bash(npx tsx:*)",
      "Bash(npx vitest run:*)",
      "Bash(pnpm install:*)",
      "WebSearch",
      "WebFetch(domain:deepwiki.com)",
      "WebFetch(domain:gist.github.com)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:wezfurlong.org)",
      "WebFetch(domain:wezterm.org)",
      "WebFetch(domain:www.npmjs.com)",
      "WebFetch(domain:zenn.dev)",
      "mcp__discord-notify__send_discord_message"
    ],
    "defaultMode": "auto",
    "deny": [
      "Bash(grep:*)",
      "Bash(egrep:*)",
      "Bash(fgrep:*)",
      "Bash(rgrep:*)",
      "Bash(zgrep:*)",
      "Bash(zegrep:*)",
      "Bash(zfgrep:*)"
    ]
  },
  "skipAutoPermissionPrompt": true,
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "tui": "fullscreen"
}
